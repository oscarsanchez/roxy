# roxy secrets: copy to <settings root>/secrets.env (~/.config/roxy/secrets.env by default)
# and fill it in. It never goes in a repo.

# mitmweb UI password (UI listens on 127.0.0.1 only)
MITMWEB_PASSWORD=

# Secret path segment required on the Public Endpoint (Cloud Devices)
LAB_SECRET=

# Roku developer web server credentials (shared by all Physical Devices; rce keeps each Cloud Device's)
ROKU_DEV_USER=rokudev
ROKU_DEV_PASSWORD=

#!/usr/bin/env bash
# Every mechanical check, no devices or network (a local mitmdump on loopback at most):
# the pre-commit hook (.githooks) runs it.
# Usage: scripts/check [STEP...]   e.g. scripts/check glossary
#   With STEPs, only those run, in the order given; without, every step (STEPS below).
# It never reads your own settings: the settings root is a temp folder seeded from
# settings.example/, and the user data directory a temp folder too.
set -euo pipefail
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
export ROXY_CONFIG_DIR="$TMP/settings" XDG_DATA_HOME="$TMP/data"
. "$(dirname "$0")/lib.sh"
cd "$REPO_ROOT"
mkdir -p "$ROXY_CONFIG_DIR"
cp -R settings.example/. "$ROXY_CONFIG_DIR"

STEPS=(proxy grid syntax lock rce settings roxy kit compose glossary imports steps)

# step_NAME: one step; its first line is its header, == NAME: what it checks.
step_proxy() {
  echo "== proxy: proxy tests (Seam A, and the mitmproxy contract in a local mitmdump)"
  (cd proxy && uv run --quiet pytest -q)
}

step_grid() {
  echo "== grid: grid tests"
  (cd grid && uv run --quiet pytest -q)
}

step_syntax() {
  echo "== syntax: shell syntax"
  local f
  for f in bin/* install.sh scripts/* scripts/tests/* .githooks/*; do
    if [ -f "$f" ] && head -1 "$f" | grep -q bash; then bash -n "$f"; fi
  done
  bash -n scripts/lib.sh
}

step_lock() {
  echo "== lock: lab lock"
  scripts/tests/lab-lock.sh >/dev/null
}

step_rce() {
  echo "== rce: Cloud Device scripts (fake rce)"
  scripts/tests/rce-scripts.sh >/dev/null
}

step_settings() {
  echo "== settings: settings and Recordings (fake mitmweb)"
  scripts/tests/settings.sh >/dev/null
}

step_roxy() {
  echo "== roxy: roxy CLI and install (fake curl and rce)"
  scripts/tests/roxy.sh >/dev/null
}

step_kit() {
  echo "== kit: kit builds (example apps, with and without the kit)"
  scripts/tests/kit-build.sh >/dev/null
}

step_compose() {
  echo "== compose: compose config"
  if command -v docker >/dev/null && docker compose version >/dev/null 2>&1; then
    docker compose config -q
  else
    echo "skipped: no docker compose CLI"
  fi
}

step_glossary() {
  echo "== glossary: glossary"
  (cd proxy && uv run --quiet python ../scripts/check-glossary)
}

step_imports() {
  echo "== imports: test imports"
  # Proxy tests reach the lab through tests/chain.py (the full addon chain), never a lab module;
  # App Profiles and the Lab Session client, which bin/roxy and the scripts use too, are tested at
  # their own interfaces.
  if grep -nE '^[[:space:]]*(from|import)[[:space:]]+lab([.[:space:]]|$)' proxy/tests/test_*.py \
    | grep -vE ':[[:space:]]*from lab\.(app_profiles|lab_session) import '; then
    die "proxy tests import lab modules (above); go through tests/chain.py instead"
  fi
}

step_steps() {
  echo "== steps: scripts/check runs the steps it is given"
  scripts/tests/check.sh >/dev/null
}

[ $# -gt 0 ] || set -- "${STEPS[@]}"
for name in "$@"; do
  case " ${STEPS[*]} " in *" $name "*) ;; *) die "unknown step '$name' (steps: ${STEPS[*]})" ;; esac
done
for name in "$@"; do "step_$name"; done

echo "all checks passed"

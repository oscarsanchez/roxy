#!/usr/bin/env bash
# Fill grid cells (Lab App flavour x Target Device kind x traffic class) through the running
# lab and print pass, fail or known-limit with a reason for each, as evaluation rows.
# Usage: scripts/grid <flavours> <device-kinds> <traffic-classes> [--proxy-base URL] [--ca-routing] [--separator /|/;|/,/;]
#                    [--device NAME]
#   e.g. scripts/grid classic physical json            one cell
#        scripts/grid classic,rsg physical all         a batch: comma lists, or all
#   A batch runs its cells one after another: Physical Device cells first, then by flavour,
#   separator and class. Each flavour is deployed once per Target Device. It ends with a table
#   of every cell's row and a count of each outcome. A failing cell does not stop it; Ctrl-C does.
#   --ca-routing: the cells in CA Routing, on the Physical Device behind the CA Routing router
#   (docs/ca-routing.md); needs scripts/start-lab --ca-routing.
#   --separator '/;': the Lab App builds Charles-style Prefixed URLs (its separator launch
#   param); the default / is the lab's own form; '/,/;' runs each cell in both. Quote it:
#   ; ends a shell command.
#   --device NAME: the Target Device for this call (one device kind), instead of the one
#   grid_devices in settings.json names: the device on the network the Mac is on now.
#   Needs scripts/start-lab running (with --tunnel for a Cloud Device: its cells launch with
#   the tunnel's public Proxy Base, as scripts/launch does; --proxy-base URL sends another).
#   Cells, scenarios and expected hosts: grid/cells.toml.
#   Cloud Device cells print their projected RCE time and cost and ask once before touching
#   RCE; the grid starts the Cloud Device if it has no Run (capped to cover the batch), keeps
#   it across the cells, and stops it after the last one if it started it.
#   Exit status: 0 if every cell is pass or known-limit, 1 if any failed.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
lab_lock devices  # held across the cells; their deploys and launches inherit it
cd "$REPO_ROOT/grid"
uv run --quiet python -u run_cell.py "$@"  # -u: keep its lines in order with deploy's

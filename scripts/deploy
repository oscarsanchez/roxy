#!/usr/bin/env bash
# Package a Lab App and sideload it to a named Target Device.
# Usage: scripts/deploy [--ca-routing] <device-name> <app-dir>      e.g. scripts/deploy "Living Room" apps/classic
#   A Physical Device is reached on the LAN, a Cloud Device through the rce CLI (rce sideload).
#   An app dir with a roku-config.ts is the RSG 2.0 flavour (apps/rsg), built with the rk CLI.
#   --ca-routing: the CA Routing build of the Lab App (Physical Devices only). It calls
#   Origin URLs directly and trusts public roots plus the lab's mitmproxy CA: classic
#   combines Roku's bundle with the CA on the device; RSG 2.0 ships a bundle combined
#   here (certifi's roots from the proxy venv plus the CA), as HttpsAgent needs a pkg:/ file.
#   ROXY_KIT=1: build a kit example (kit/example-*) with the kit's build-time constant set.
set -euo pipefail
. "$(dirname "$0")/lib.sh"

usage="usage: scripts/deploy [--ca-routing] <device-name> <app-dir>"
ca_routing=false
if [ "${1:-}" = "--ca-routing" ]; then
  ca_routing=true
  shift
fi
[ $# -eq 2 ] || die "$usage"
device="$1"
app_dir="$(cd "$2" && pwd)"
lab_lock devices

# package_app APP-DIR PROXY-BASE : zip the app with PROXY-BASE baked in as the build-time default.
package_app() {
  local name stage zip
  name="$(basename "$1")"
  stage="$REPO_ROOT/out/$name"
  zip="$REPO_ROOT/out/$name.zip"
  rm -rf "$stage" "$zip"
  mkdir -p "$REPO_ROOT/out"
  cp -R "$1" "$stage"
  printf 'lab_proxy_base=%s\n' "$2" >> "$stage/manifest"
  if [ "${ROXY_KIT:-}" = 1 ]; then  # the kit's build-time constant (kit/example-classic)
    sed -i.bak 's/roxy_kit=false/roxy_kit=true/' "$stage/manifest" && rm "$stage/manifest.bak"
  fi
  if $ca_routing; then  # the app combines this CA with Roku's bundle on the device
    mkdir -p "$stage/certs"
    cp "$LAB_CA_CERT" "$stage/certs/lab-ca.crt"
    printf 'lab_ca_routing=true\n' >> "$stage/manifest"
  fi
  (cd "$stage" && zip -qr "$zip" . -x '.*')
  echo "$zip"
}

# rsg_ca_bundle : write the RSG CA Routing build's certificate bundle (certifi's public
# roots, as the proxy venv has them, plus the lab's CA) into out/; print its path.
rsg_ca_bundle() {
  local bundle="$REPO_ROOT/out/lab-ca-bundle.crt" roots
  roots="$(cd "$REPO_ROOT/proxy" && uv run --quiet python -c 'import certifi; print(certifi.where())')" \
    || die "could not find certifi's bundle in the proxy venv (cd proxy && uv sync)"
  mkdir -p "$REPO_ROOT/out"
  cat "$roots" "$LAB_CA_CERT" > "$bundle"
  echo "$bundle"
}

# build_rsg_app APP-DIR PROXY-BASE : rk build with PROXY-BASE as the build-time default;
# prints the squashfs package. --debug keeps console.* (a release build drops the result lines).
# A CA Routing build also gets LAB_CA_BUNDLE, which roku-config.ts copies into the package.
build_rsg_app() {
  local out ca_bundle=""
  out="$REPO_ROOT/out/$(basename "$1")"
  if $ca_routing; then ca_bundle="$(rsg_ca_bundle)"; fi
  if [ -d /opt/homebrew/opt/node@24/bin ]; then PATH="/opt/homebrew/opt/node@24/bin:$PATH"; fi
  [ "$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)" -ge 24 ] \
    || die "the RSG 2.0 app needs Node 24+ (brew install node@24)"
  [ -d "$1/node_modules" ] || (cd "$1" && pnpm install --frozen-lockfile >&2) || die "pnpm install failed in $1"
  (cd "$1" && LAB_PROXY_BASE="$2" LAB_CA_BUNDLE="$ca_bundle" ROXY_CA_BUNDLE="$ca_bundle" ./node_modules/.bin/rk build --debug --local --archive --out-dir "$out" >&2) \
    || die "rk build failed for $1"
  echo "$out/package/package.bin"
}

# package APP-DIR PROXY-BASE : the app's flavour decides how it is packaged.
package() {
  if [ -f "$1/roku-config.ts" ]; then build_rsg_app "$@"; else package_app "$@"; fi
}

# sideload INSTALLER-URL ZIP : the dev installer answers 200 even on failure.
# The Roku answers the digest round's 401 and closes while curl is still sending the body;
# with a larger package (RSG 2.0 + RAF) that ends as "Broken pipe" about 1 time in 2: retry.
sideload() {
  local url="$1" zip="$2" page
  page="$(curl -sS --fail --retry 3 --retry-all-errors --digest -u "$ROKU_DEV_USER:$ROKU_DEV_PASSWORD" \
    -F "mysubmit=Install" -F "archive=@$zip" "$url/plugin_install")" \
    || die "sideload request to $url failed"
  if echo "$page" | grep -qE 'Install Success|Identical to previous version'; then
    echo "installed $(basename "$zip") on $device"
  else
    echo "$page" | sed -e 's/<[^>]*>//g' | grep -iE 'fail|error' >&2 || true
    die "sideload to $device was not confirmed"
  fi
}

ip="$(device_field "$device" ip)"
rce_name="$(rce_device_name "$device")"
if $ca_routing; then
  [ -n "$ip" ] || die "CA Routing is for Physical Devices only"
  [ -f "$LAB_CA_CERT" ] || die "no lab CA at $LAB_CA_CERT: start the lab once (scripts/start-lab) to create it"
fi
if [ -n "$ip" ]; then  # Physical Device: dev web server on the LAN, with the shared dev password
  load_env
  require_env ROKU_DEV_USER ROKU_DEV_PASSWORD
  pkg="$(package "$app_dir" "$(lan_proxy_base)")"
  sideload "http://$ip" "$pkg"
elif [ -n "$rce_name" ]; then  # Cloud Device: rce signs in with its own dev password (rce device setup-dev)
  # The baked LAN default is unreachable from RCE: scripts/launch passes the public Proxy Base.
  pkg="$(package "$app_dir" "$(lan_proxy_base)")"
  rce sideload "$rce_name" "$pkg" || die "sideload to $device failed"
else
  die "device '$device' has no deploy route: set ip (Physical Device) or rce_device_name (Cloud Device) in $DEVICES_FILE"
fi

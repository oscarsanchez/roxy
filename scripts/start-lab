#!/usr/bin/env bash
# Start the lab: mitmweb with the lab addon chain, listening on the LAN for Prefixed URLs.
# Usage: scripts/start-lab [--tunnel] [--ca-routing] [--replay SESSION]
#   --tunnel also opens a Cloudflare quick tunnel to the listener (the Public
#   Endpoint, for Cloud Devices) and prints the public Proxy Base. Stopping the
#   lab (Ctrl-C) closes the tunnel too.
#   --ca-routing also listens on ports 443 and 80 for CA Routing (phase 2,
#   Physical Devices on the GL.iNet; see docs/ca-routing.md).
#   --replay SESSION answers requests from a saved session (a .mitm file) with
#   mitmproxy's server replay instead of asking the Origin; requests it did not
#   record get a 404 and never reach their Origin.
# Settings and secrets come from the settings root (scripts/lib.sh); a missing one
# stops the start, named. Every session is saved to the user data directory
# (CAPTURES_DIR in scripts/lib.sh, by scripts/run-mitmweb).
set -euo pipefail
. "$(dirname "$0")/lib.sh"

TUNNEL_METRICS="127.0.0.1:20241"  # cloudflared's local metrics server: readiness and the quick tunnel hostname

usage="usage: scripts/start-lab [--tunnel] [--ca-routing] [--replay SESSION]"
tunnel=false
export LAB_CA_ROUTING=false  # read by scripts/run-mitmweb
replay=""
while [ $# -gt 0 ]; do
  case "$1" in
    --tunnel) tunnel=true; shift ;;
    --ca-routing) LAB_CA_ROUTING=true; shift ;;
    --replay) [ $# -ge 2 ] || die "$usage"; replay="$2"; shift 2 ;;
    *) die "$usage" ;;
  esac
done
if [ -n "$replay" ]; then
  [ -f "$replay" ] || die "no saved session at $replay"
  export LAB_REPLAY="$(cd "$(dirname "$replay")" && pwd)/$(basename "$replay")"  # read by run-mitmweb
fi

load_env
require_env MITMWEB_PASSWORD
require_settings
lab_lock lab  # one lab per user; deploy, launch and grid take the devices lock instead
if $tunnel; then
  require_env LAB_SECRET
  command -v cloudflared >/dev/null || die "cloudflared is required for --tunnel (brew install cloudflared)"
fi

# quick_tunnel_host : wait for the tunnel's edge connection, then print its hostname.
quick_tunnel_host() {
  local i
  for i in $(seq 30); do
    if curl -fsS -o /dev/null "http://$TUNNEL_METRICS/ready" 2>/dev/null; then
      curl -fsS "http://$TUNNEL_METRICS/quicktunnel" | jq -er '.hostname | select(. != "")'
      return
    fi
    sleep 1
  done
  return 1
}

echo "mitmweb UI:        http://127.0.0.1:$LAB_WEB_PORT  (password: MITMWEB_PASSWORD in $SECRETS_FILE)"
echo "LAN Proxy Base:    $(lan_proxy_base)"
if [ "$LAB_CA_ROUTING" = true ]; then
  echo "CA Routing:        ports $LAB_CA_ROUTING_PORTS on $(lan_ip); point lab Origins here in DNS (docs/ca-routing.md)"
fi

# mitmweb and the tunnel stop together, whichever way the lab stops.
pids=""
on_exit 'kill $pids 2>/dev/null || true'
trap 'exit 130' INT TERM

"$REPO_ROOT/scripts/run-mitmweb" uv run mitmweb &
mitmweb_pid=$!
pids="$mitmweb_pid"

if $tunnel; then
  mkdir -p "$REPO_ROOT/out"
  tunnel_log="$REPO_ROOT/out/cloudflared.log"
  # The tunnel dials its own listener (loopback only): that is how the lab tells tunnel requests apart.
  cloudflared tunnel --no-autoupdate --metrics "$TUNNEL_METRICS" --url "http://127.0.0.1:$LAB_TUNNEL_PORT" \
    >"$tunnel_log" 2>&1 &
  pids="$pids $!"
  host="$(quick_tunnel_host)" || die "the quick tunnel did not come up (see $tunnel_log)"
  echo "Public Proxy Base: https://$host/$LAB_SECRET  (Cloud Devices; scripts/launch adds the device slug; DNS can take a few seconds)"
fi

wait "$mitmweb_pid"

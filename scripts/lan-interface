#!/usr/bin/env bash
# Print the Mac's LAN interface: the first active Wi-Fi or Ethernet interface (one
# with an IPv4 address) in macOS's network service order, skipping VPN (utun), bridge and
# loopback interfaces. Not the default route's: a VPN can hold that. The one lookup of the
# Mac's LAN IP: lan_ip in scripts/lib.sh runs it.
# Exits 1, printing nothing, when no such interface is active.
# Usage: scripts/lan-interface
set -euo pipefail

while read -r device; do
  case "$device" in ''|utun*|bridge*|lo*) continue ;; esac
  if ipconfig getifaddr "$device" >/dev/null 2>&1; then
    echo "$device"
    exit 0
  fi
done < <(networksetup -listnetworkserviceorder 2>/dev/null | sed -n 's/.*Device: \([^)]*\)).*/\1/p')
exit 1

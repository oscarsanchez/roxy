#!/usr/bin/env bash
# roxy: the lab's CLI, from any terminal. A thin dispatcher over scripts/, which keep the
# one implementation of each behaviour. install.sh links it onto the PATH.
# Usage: roxy <subcommand> [args...]; roxy <subcommand> --help describes one.
set -euo pipefail
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../scripts/lib.sh"
SCRIPTS="$REPO_ROOT/scripts"

# usage SUBCOMMAND : its help text.
usage() {
  case "$1" in
    roxy) cat <<'EOF'
usage: roxy <subcommand> [args...]
The roxy lab from any terminal. roxy <subcommand> --help describes one.
  start      run the lab in the foreground, until Ctrl-C
  status     whether the lab is up, its Proxy IP, Proxy Bases, Proxy Routing address,
             App Profile and Scenarios
  scenario   list the Scenarios, or set, add, remove or clear the active ones
  launch     launch the dev channel on a Target Device, with its Proxy Base
  flows      the running lab's flows as JSON, for agents (read-only)
  export     a Recording as a HAR file, for HAR viewers and bug reports
  console    open a Target Device's debug console
  app        create or list App Profiles
  device     register, list or remove Target Devices, or discover Rokus
  setup      fill your roxy settings for this Mac (run it again any time)
EOF
    ;;
    start) cat <<'EOF'
usage: roxy start [--app NAME] [--tunnel] [--ca-routing] [--replay RECORDING]
Run the lab in the foreground until Ctrl-C. It prints the mitmweb UI, the Proxy Bases
and the Proxy Routing address (the HTTP proxy a Proxied Device sets).
  --app NAME        load the App Profile NAME; without it, the profile whose repo holds
                    the current folder, if any (roxy app list)
  --tunnel          also open the Public Endpoint, for Cloud Devices
  --ca-routing      also listen on ports 443 and 80 for CA Routing
  --replay RECORDING
                    answer from a Recording (.mitm) instead of the Origins
EOF
    ;;
    status) cat <<'EOF'
usage: roxy status [--json] [--since RUN|TIME] [--show-secret]
Whether the lab is up and, when it is, its Proxy IP, its Proxy Bases, its Proxy Routing
address, its App Profile and the active Scenarios in order, each with its source and its
rules, with how many flows each rule acted on: a rule that acted on none is flagged.
Exits 1 when the lab is down. After a roxy launch, check roxy status --since <run>. The public Proxy Base
shows its secret segment as <secret>.
  --json            the running lab's state as one JSON object, for tools: its App
                    Profile (app, null for none), its active Scenarios in order
                    (scenarios), whether it is in CA Routing (ca_routing), its Proxy
                    Routing listener's port (proxy_routing_port), the folder of its own
                    Scenarios (scenarios_dir), and the active Scenarios' rules in
                    Scenario then file order (rules: [{"scenario", "rule", "flows"}])
  --since RUN|TIME  count only flows since a roxy launch run id, or a time like
                    2026-11-20T10:00:00Z
  --show-secret     print the real public Proxy Base, to paste into a Cloud Device by
                    hand: the output then holds the lab's secret (not with --json,
                    which carries no Proxy Base)
EOF
    ;;
    scenario) cat <<'EOF'
usage: roxy scenario list [--app NAME] | set NAME... | add NAME | remove NAME | clear
Any number of Scenarios can be active, lab-wide: their rules apply in set order, then
file order. set, add, remove and clear print the active ones after the change.
  list         the Scenarios of the App Profile roxy start would load here (or NAME's)
               and the lab's own, each once with its source (a name in both: refused)
  set NAME...  make NAMEs the running lab's active Scenarios, in that order
  add NAME     make NAME active too, after the active ones
  remove NAME  stop NAME's rules, leaving the other active Scenarios
  clear        leave the running lab with no active Scenario
EOF
    ;;
    launch) cat <<'EOF'
usage: roxy launch [--scenario NAME]... [--proxy-base URL] <device> [key=value...]
Launch the dev channel on <device> (a name in devices.json), with proxyBase and your
launch params. It never builds or sideloads. proxyBase is the LAN Proxy Base for a
Physical Device, and the running tunnel's public Proxy Base plus the device slug for a
Cloud Device (roxy start --tunnel). Prints run=<id>, also sent as the run param.
The Lab Apps read case=<case> and 'separator=/;' (Charles-style Prefixed URLs; quoted,
as ; ends a shell command); without separator they use the lab's own /.
  --scenario NAME   set the running lab's active Scenarios first, in the order given
                    (repeat it for several; '' clears them)
  --proxy-base URL  send URL instead (a Cloud Device's slug is still added)
EOF
    ;;
    flows) cat <<'EOF'
usage: roxy flows --json [--filter EXPR] [--since RUN|TIME] [--limit N]
The running lab's flows, oldest first, as one JSON array in the shape docs/agent-setup.md
documents (Flows for agents). Read-only: it never holds or edits a flow.
  --filter EXPR     only flows matching a mitmproxy filter expression, e.g. '~d example.com'
  --since RUN|TIME  only flows since a roxy launch run id, or a time like 2026-11-20T10:00:00Z
  --limit N         only the last N flows
EOF
    ;;
    export) cat <<'EOF'
usage: roxy export --har [RECORDING] [--filter EXPR] [-o FILE]
Write a Recording (.mitm) as a HAR file, one entry per HTTP flow, and print its path and
number of entries. It reads the file only, so the lab can be up or down; a running lab's
Recording exports the flows recorded so far. Request URLs are Origin URLs; response
bodies are as the Target Device received them, so URLs inside them are Prefixed URLs.
The lab secret becomes <secret> everywhere, but the HAR holds everything else the
Recording held, the app's headers, cookies and tokens included: check it before sharing.
  RECORDING         the Recording; without it, the newest of all in the Recordings root
                    (~/.local/share/roxy/captures/: every App Profile's folder and
                    no-profile)
  --filter EXPR     only flows matching a mitmproxy filter expression, e.g. '~d example.com'
  -o FILE           where to write it, never over an existing file (default:
                    ./<recording name>.har)
EOF
    ;;
    console) cat <<'EOF'
usage: roxy console <device> [--launch CASE [--scenario NAME]] [--seconds N]
A Physical Device's debug console, recorded to out/console/ for N seconds (default 60);
--launch launches CASE once connected. A Cloud Device's console streams through
rce console while its Run is up (no options).
EOF
    ;;
    app) cat <<'EOF'
usage: roxy app new NAME | list
An App Profile keeps one Product App's Scenarios, their mocks and its Public Endpoint
allowlist in your roxy settings, outside every repo.
  new NAME  create the App Profile NAME for the git repo you are in
  list      the App Profiles and their repos
EOF
    ;;
    device) cat <<'EOF'
usage: roxy device add NAME (--ip IP [--proxied] | --rce DEVICE_NAME [--slug SLUG])
       roxy device list | remove NAME | discover
The Target Devices in your roxy settings (devices.json), which name each flow, and the
LAN subnets allowed to use the lab (lan_subnets in settings.json), kept in step. Restart
a running lab to use a change.
  add NAME --ip IP     register the Roku at IP (a Physical Device); warns, and still
                       registers it, when it does not answer ECP or is not in
                       developer mode. An IP lan_subnets does not cover is added to
                       them as IP/32
    --proxied          a Proxied Device instead: a phone, tablet or other non-Roku
                       device using the lab through Proxy Routing
  add NAME --rce DEVICE_NAME
                       register a Cloud Device by its rce Device Name (rce device
                       list); warns, and still registers it, when rce device resolve
                       does not know it
    --slug SLUG        its slug in the public Proxy Base (default: NAME in lowercase,
                       with dashes)
  list                 each device with its IP or rce Device Name, and its kind
  remove NAME          unregister NAME; drops its IP/32 from lan_subnets unless
                       another device has that IP (a wider subnet is never touched)
  discover             the Rokus on this network (SSDP, about 3 s), each with its IP,
                       own name, model, developer mode and registered name, and the
                       roxy device add line for each one not registered; adds nothing
EOF
    ;;
    setup) cat <<'EOF'
usage: roxy setup [--trusted-network | --this-mac-only] [--roku-user USER]
Fill your roxy settings for this Mac, keeping what is there: run it again any time. It
generates the mitmweb password (MITMWEB_PASSWORD in secrets.env, which the mitmweb UI
asks for), allows this Mac in lan_subnets, and takes your Roku developer login (one for
all your Rokus). Secrets are written to secrets.env, readable only by you, and never
printed. In a terminal it shows each value and keeps it on Enter. Without one it never
asks: the Roku password comes from stdin (pipe it in), never from a flag, and without it
setup says so. Restart a running lab to use a change.
  --trusted-network  allow this Mac's whole subnet in lan_subnets: every device on a
                     network you trust, such as home, can use the lab
  --this-mac-only    allow only this Mac's address in lan_subnets (the default, when
                     there are none yet): on a shared network, such as work, no one
                     else can relay through your lab. Either flag replaces lan_subnets,
                     keeping each registered device's IP/32
  --roku-user USER   the Roku developer web server's user (default: rokudev)
EOF
    ;;
  esac
}

# status [options] : the lab, App Profile and Scenario lines from the Lab Session
# (proxy/cli.py, which checks the other options), with the Proxy IP, Proxy Bases and Proxy Routing lines
# after the first; --show-secret keeps the secret in the public Proxy Base.
status() {
  local lab public show_secret=false arg args=()
  for arg in "$@"; do
    if [ "$arg" = --show-secret ]; then show_secret=true; else args+=("$arg"); fi
  done
  set -- ${args[@]+"${args[@]}"}
  case " $* " in *" --json "*)
    ! $show_secret || die "--json carries no Proxy Base, so no secret to show: drop --show-secret. $(usage status | head -1)"
    proxy_cli status "$@"; return ;;
  esac
  load_env
  lab="$(proxy_cli status "$@")" || { [ -z "$lab" ] || echo "$lab"; exit 1; }
  public="$(public_proxy_base)" || public="none (no tunnel; roxy start --tunnel)"
  $show_secret || public="$(redact_secret "$public")"
  head -1 <<< "$lab"
  print_lan_addresses "$(lan_ip)"
  echo "Public Proxy Base: $public"
  tail -n +2 <<< "$lab"
}

scenario() {
  case "${1:-} $# ${2:-}" in
    "list 1 "|"list 3 --app") proxy_cli scenario "$@" ;;
    "set 1 ") die "$(usage scenario | head -1)" ;;
    "set "*) shift; proxy_cli scenario set -- "$@" ;;
    "add 2 "*|"remove 2 "*) proxy_cli scenario "$1" -- "$2" ;;
    "clear 1 ") proxy_cli scenario clear ;;
    *) die "$(usage scenario | head -1)" ;;
  esac
}

# console DEVICE [options] : a Cloud Device's console through rce, a Physical Device's
# through scripts/console.
console() {
  [ $# -ge 1 ] || die "$(usage console | head -1)"
  local rce_name
  rce_name="$(rce_device_name "$1")"
  if [ -n "$rce_name" ]; then
    [ $# -eq 1 ] || die "a Cloud Device's console takes no options: $(usage console | head -1)"
    exec rce console "$rce_name"
  fi
  exec "$SCRIPTS/console" "$@"
}

app() {
  case "${1:-} $#" in
    "new 2") proxy_cli app new -- "$2" ;;
    "list 1") proxy_cli app list ;;
    *) die "$(usage app | head -1)" ;;
  esac
}

device() {
  case " $* " in *" -h "*|*" --help "*) usage device; return ;; esac
  case "${1:-} $#" in
    "add "*) proxy_cli device "$@" ;;
    "list 1") proxy_cli device list ;;
    "remove 2") proxy_cli device remove -- "$2" ;;
    "discover 1") proxy_cli device discover ;;
    *) die "$(usage device | head -2)" ;;
  esac
}

# setup [options] : never the Roku password as a flag, which shell history and process
# lists would keep.
setup() {
  case " $* " in *" -h "*|*" --help "*) usage setup; return ;; esac
  case " $* " in *" --roku-password"*)
    die "the Roku password is never a flag: pipe it to roxy setup, or run roxy setup in a terminal" ;;
  esac
  proxy_cli setup "$@"
}

cmd="${1:-}"
[ -n "$cmd" ] || { usage roxy >&2; exit 2; }
shift
case "$cmd" in
  -h|--help) usage roxy; exit 0 ;;
  start|status|scenario|launch|flows|export|console|app|device|setup) ;;
  *) die "unknown subcommand '$cmd' (roxy --help lists them)" ;;
esac
case "${1:-}" in -h|--help) usage "$cmd"; exit 0 ;; esac

case "$cmd" in
  start) exec "$SCRIPTS/start-lab" "$@" ;;
  status) status "$@" ;;
  scenario) scenario "$@" ;;
  launch) exec "$SCRIPTS/launch" "$@" ;;
  flows) proxy_cli flows "$@" ;;
  export) proxy_cli export "$@" ;;
  console) console "$@" ;;
  app) app "$@" ;;
  device) device "$@" ;;
  setup) setup "$@" ;;
esac

<?xml version="1.0" encoding="utf-8"?>
<component name="HttpTask" extends="Task">
  <interface>
    <field id="url" type="string"/>
    <!-- empty: GET; otherwise POSTed as application/json -->
    <field id="body" type="string"/>
    <!-- {status, bytes, fp, text}: status is the HTTP code, or a negative curl code -->
    <field id="result" type="assocarray"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/components/Certificates.brs"/>
  <script type="text/brightscript" uri="pkg:/components/Fingerprint.brs"/>
  <script type="text/brightscript" uri="pkg:/components/HttpTask.brs"/>
</component>
